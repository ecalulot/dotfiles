#!/bin/bash

# Description: Link dotfiles to home directory

# --- start original code ---
mkdir -p ~/.config

link_file() {
	for file in "${dotfile_arr[@]}"; do
		ln -sf "$HOME/dotfile/${file}" "$HOME/.${file}"
		echo "File ${file} linked!"
	done 
}


dotfile_arr=("bashrc" "vimrc" "tmux.conf" "bash_aliases")

ln -sf ~/dotfiles/starship.toml ~/.config/starship.toml # hard code this one

echo "Setup complete!"
